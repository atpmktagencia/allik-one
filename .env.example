# Somente servidor. Nunca use prefixo VITE_ nestas variáveis.
DATABASE_URL=
INVENTORY_ENVIRONMENT=development
INVENTORY_PREVIEW_PASSWORD=
INVENTORY_SESSION_SECRET=
# Quando true, dispensa o login interno somente se INVENTORY_ENVIRONMENT e
# VERCEL_ENV forem ambos preview e os dados forem classificados como sintéticos.
# Exige Deployment Protection ativa na Vercel.
INVENTORY_DISABLE_PREVIEW_LOGIN=false
INVENTORY_PREVIEW_DATA_CLASSIFICATION=
# Autorize explicitamente apenas o comando de seed em banco sintético isolado.
INVENTORY_ALLOW_SEED=false
# Somente Preview Vercel sintético, com autorização explícita de seed.
INVENTORY_PREPARE_PREVIEW=false

# Assinatura digital Lacuna, somente servidor e com credencial própria do ambiente.
# Habilitar VIDaaS/BirdID na instância Rest PKI Core com a Lacuna.
LACUNA_REST_PKI_CORE_API_KEY=
LACUNA_REST_PKI_CORE_URL=https://core.pki.rest/
# URL HTTPS estável do mesmo ambiente, também cadastrada no provedor.
SIGNATURE_PUBLIC_ORIGIN=
# Chave persistente 32+ caracteres para criptografar identidades. Não reutilizar no frontend.
# Manter junto ao procedimento de restauração; trocar exige recadastrar identidades.
DOCUMENT_SIGNATURE_SECRET=

# Password recovery: opt in only after verifying a Resend sending domain.
AUTH_RECOVERY_ENABLED=false
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Required in production; Preview uses its own VERCEL_URL.
AUTH_PUBLIC_ORIGIN=

# Laboratory PDF extraction: disabled until a compatible live Gateway model is selected.
LAB_EXTRACTION_ENABLED=false
LAB_EXTRACTION_MODEL=

# Choose gateway (default) or openai; never automatic cross-provider fallback.
LAB_EXTRACTION_PROVIDER=gateway
# Direct OpenAI only: add as a server secret, never VITE_/NEXT_PUBLIC_.
# OPENAI_API_KEY=
